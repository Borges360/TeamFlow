{
  "name": "teamflow",
  "version": "0.1.1",
  "description": "CLI local do teamFlow para times reutilizáveis, projetos isolados e setup via npx.",
  "type": "module",
  "bin": {
    "teamflow": "bin/teamflow.js"
  },
  "files": [
    "bin/",
    "src/",
    ".squad/",
    "AGENTS.md",
    "squad.yaml",
    "start.md",
    "docs/local-teams-cli.md"
  ],
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.5.1"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "check": "npm run check:runtime && npm run check:versions && npm test",
    "check:runtime": "node scripts/package/check-runtime.mjs",
    "check:versions": "node scripts/package/check-versions.mjs",
    "test": "node --test --test-reporter=spec test/install.test.js test/update.test.js test/version-and-cli.test.js test/teamflow-local.test.js",
    "test:package": "node scripts/package/test-packed-package.mjs",
    "release:verify": "node scripts/package/verify-release.mjs",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borges360/TeamFlow.git"
  },
  "homepage": "https://github.com/Borges360/TeamFlow#readme",
  "bugs": {
    "url": "https://github.com/Borges360/TeamFlow/issues"
  },
  "keywords": [
    "agents",
    "agentic-workflow",
    "cli",
    "engineering",
    "teamflow"
  ],
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  }
}
