{
  "name": "teamflow",
  "version": "0.1.1",
  "private": true,
  "description": "CLI local do teamFlow para times reutilizáveis, projetos isolados e setup local.",
  "type": "module",
  "bin": {
    "teamflow": "bin/teamflow.js"
  },
  "files": [
    "bin/",
    "dist/",
    "runtime-assets/"
  ],
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.5.1"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "build": "node scripts/package/build-runtime.mjs",
    "check": "npm run build && npm run check:runtime && npm run check:versions && npm test",
    "check:runtime": "node scripts/package/check-runtime.mjs",
    "check:versions": "node scripts/package/check-versions.mjs",
    "test": "node --test --test-reporter=spec test/version-and-cli.test.js test/teamflow-local.test.js",
    "test:package": "node scripts/package/test-packed-package.mjs",
    "release:verify": "node scripts/package/verify-release.mjs",
    "prepack": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Borges360/TeamFlow.git"
  },
  "homepage": "https://github.com/Borges360/TeamFlow#readme",
  "bugs": {
    "url": "https://github.com/Borges360/TeamFlow/issues"
  },
  "keywords": [
    "agents",
    "agentic-workflow",
    "cli",
    "engineering",
    "teamflow"
  ],
  "license": "UNLICENSED"
}
